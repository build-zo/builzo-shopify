{% comment %}
  FILE: sections/footer.liquid
  Quick commerce footer with USPs, links, and app badges
{% endcomment %}



<footer class="qc-footer" data-section-id="{{ section.id }}" role="contentinfo">

  {%- if section.settings.show_usps -%}
  <div class="qc-footer__usps">
    <div class="qc-footer__usp">
      <span class="qc-footer__usp-icon">⚡</span>
      <span>Construction Material in Minutes</span>
    </div>
    <div class="qc-footer__usp-divider" aria-hidden="true"></div>
    <div class="qc-footer__usp">
      <span class="qc-footer__usp-icon">📦</span>
      <span>Assured Quality Products</span>
    </div>
    <div class="qc-footer__usp-divider" aria-hidden="true"></div>
    <div class="qc-footer__usp">
      <span class="qc-footer__usp-icon">↩️</span>
      <span>Easy returns</span>
    </div>
    <div class="qc-footer__usp-divider" aria-hidden="true"></div>
    <div class="qc-footer__usp">
      <span class="qc-footer__usp-icon">💳</span>
      <span>Secure payments</span>
    </div>
  </div>
  {%- endif -%}

  <div class="qc-footer__main">
    <div class="qc-footer__brand">
      <a href="{{ routes.root_url }}" class="qc-footer__logo" aria-label="{{ shop.name }}">
        {{ shop.name }}
      </a>
      {%- if section.settings.tagline != blank -%}
        <p class="qc-footer__tagline">{{ section.settings.tagline }}</p>
      {%- endif -%}
      {%- if section.settings.show_social -%}
      <div class="qc-footer__social" aria-label="Social media links">
        {%- if section.settings.instagram != blank -%}
          <a href="{{ section.settings.instagram }}" class="qc-footer__social-link" aria-label="Instagram" target="_blank" rel="noopener">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.facebook != blank -%}
          <a href="{{ section.settings.facebook }}" class="qc-footer__social-link" aria-label="Facebook" target="_blank" rel="noopener">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.twitter != blank -%}
          <a href="{{ section.settings.twitter }}" class="qc-footer__social-link" aria-label="Twitter / X" target="_blank" rel="noopener">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        {%- endif -%}
      </div>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      {%- if block.type == 'link_column' -%}
        <div class="qc-footer__col" {{ block.shopify_attributes }}>
          <h3 class="qc-footer__col-title">{{ block.settings.heading }}</h3>
          <ul class="qc-footer__links" role="list">
            {%- assign menu = linklists[block.settings.menu] -%}
            {%- for link in menu.links -%}
              <li><a href="{{ link.url }}" class="qc-footer__link">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="qc-footer__bottom">
    <p class="qc-footer__copy">
      © {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
    </p>
    <div class="qc-footer__payments" aria-label="Accepted payment methods">
      {%- for type in shop.enabled_payment_types -%}
        {{ type | payment_type_svg_tag: class: 'qc-footer__payment-icon' }}
      {%- endfor -%}
    </div>
  </div>

</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_usps",
      "label": "Show USP strip",
      "default": true
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Brand tagline",
      "default": "Groceries in 10 minutes, always fresh."
    },
    {
      "type": "header",
      "content": "Social media"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social links",
      "default": true
    },
    {
      "type": "url",
      "id": "instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "facebook",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "twitter",
      "label": "Twitter / X URL"
    }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "link_column",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column heading",
          "default": "Company"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "link_column", "settings": { "heading": "Company" } },
        { "type": "link_column", "settings": { "heading": "Help" } },
        { "type": "link_column", "settings": { "heading": "Legal" } }
      ]
    }
  ]
}
{% endschema %}