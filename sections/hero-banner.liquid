{% comment %}
  FILE: sections/hero-banner.liquid
  Blinkit-style sliding hero banner — mobile/desktop images, size controls
{% endcomment %}

{%- assign h_desk = section.settings.height_desktop | default: 300 -%}
{%- assign h_mob  = section.settings.height_mobile  | default: 200 -%}
{%- assign hsize  = section.settings.heading_size   | default: 36 -%}
{%- assign subsize = section.settings.subheading_size | default: 15 -%}
{%- assign talign = section.settings.text_align | default: 'left' -%}

<style>
  #hero-{{ section.id }} .qc-hero__slide       { min-height: {{ h_desk }}px; }
  #hero-{{ section.id }} .qc-hero__heading      { font-size: {{ hsize }}px; }
  #hero-{{ section.id }} .qc-hero__subheading   { font-size: {{ subsize }}px; }
  #hero-{{ section.id }} .qc-hero__slide-text   { text-align: {{ talign }}; }
  @media (max-width: 768px) {
    #hero-{{ section.id }} .qc-hero__slide { min-height: {{ h_mob }}px; }
  }
</style>

<section class="qc-hero" id="hero-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="qc-hero__track" id="heroTrack" data-speed="{{ section.settings.autoplay_speed | default: 4 }}">
    {%- for block in section.blocks -%}
      {%- if block.type == 'slide' -%}
        <div
          class="qc-hero__slide"
          style="background-color: {{ block.settings.bg_color }};"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            {%- comment -%} Responsive image: mobile vs desktop {%- endcomment -%}
            <picture>
              {%- if block.settings.image_mobile != blank -%}
                <source
                  media="(max-width: 768px)"
                  srcset="{{ block.settings.image_mobile | image_url: width: 800 }}"
                  width="800"
                />
              {%- endif -%}
              <img
                src="{{ block.settings.image | image_url: width: 1400 }}"
                alt="{{ block.settings.heading | escape }}"
                class="qc-hero__slide-img"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                width="1400"
                height="{{ h_desk }}"
              />
            </picture>
          {%- else -%}
            {%- assign h_size = section.settings.heading_size | default: 36 -%}
            {%- if block.settings.heading_size_override > 0 -%}
              {%- assign h_size = block.settings.heading_size_override -%}
            {%- endif -%}
            {%- assign sub_size = section.settings.subheading_size | default: 15 -%}
            {%- if block.settings.subheading_size_override > 0 -%}
              {%- assign sub_size = block.settings.subheading_size_override -%}
            {%- endif -%}
            <div class="qc-hero__slide-content">
              <div class="qc-hero__slide-text" style="text-align: {{ section.settings.text_align | default: 'left' }};">
                {%- if block.settings.eyebrow != blank -%}
                  <p class="qc-hero__eyebrow" style="font-size:{{ block.settings.eyebrow_size | default: 13 }}px; color:{{ block.settings.eyebrow_color | default: '#555555' }};">{{ block.settings.eyebrow }}</p>
                {%- endif -%}
                <h2 class="qc-hero__heading" style="font-size:{{ h_size }}px; color:{{ block.settings.heading_color | default: '#111111' }}; font-weight:{{ block.settings.heading_weight | default: '800' }};">{{ block.settings.heading }}</h2>
                {%- if block.settings.subheading != blank -%}
                  <p class="qc-hero__subheading" style="font-size:{{ sub_size }}px; color:{{ block.settings.subheading_color | default: '#555555' }};">{{ block.settings.subheading }}</p>
                {%- endif -%}
                {%- if block.settings.cta_label != blank -%}
                  <a href="{{ block.settings.cta_url }}" class="qc-hero__cta" style="background:{{ block.settings.cta_bg_color | default: '#111111' }}; color:{{ block.settings.cta_text_color | default: '#ffffff' }}; font-size:{{ block.settings.cta_font_size | default: 14 }}px;">
                    {{ block.settings.cta_label }}
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                  </a>
                {%- endif -%}
              </div>
              {%- if block.settings.product_image != blank -%}
                <div class="qc-hero__slide-product" style="width: {{ block.settings.product_image_width | default: 220 }}px;">
                  <picture>
                    {%- if block.settings.product_image_mobile != blank -%}
                      <source media="(max-width: 768px)" srcset="{{ block.settings.product_image_mobile | image_url: width: 300 }}" />
                    {%- endif -%}
                    <img
                      src="{{ block.settings.product_image | image_url: width: 320 }}"
                      alt="{{ block.settings.heading | escape }}"
                      width="{{ block.settings.product_image_width | default: 220 }}"
                      height="{{ block.settings.product_image_width | default: 220 }}"
                      loading="lazy"
                    />
                  </picture>
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
  <div class="qc-hero__dots" role="tablist" aria-label="Banner slides">
    {%- for block in section.blocks -%}
      {%- if block.type == 'slide' -%}
        <button
          class="qc-hero__dot{% if forloop.first %} active{% endif %}"
          data-index="{{ forloop.index0 }}"
          role="tab"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          aria-label="Slide {{ forloop.index }}"
        ></button>
      {%- endif -%}
    {%- endfor -%}
  </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed (seconds)",
      "min": 2, "max": 10, "step": 1, "default": 4
    },
    {
      "type": "header",
      "content": "Banner Size"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Height on desktop",
      "min": 160, "max": 500, "step": 10, "default": 300,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Height on mobile",
      "min": 120, "max": 360, "step": 10, "default": 200,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Text Size"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading font size",
      "min": 16, "max": 60, "step": 2, "default": 36,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading font size",
      "min": 12, "max": 24, "step": 1, "default": 15,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right" }
      ],
      "default": "left"
    }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "header",
          "content": "Images"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop banner image",
          "info": "Recommended: 1400×400px. Shown on screens wider than 768px."
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile banner image",
          "info": "Recommended: 800×400px. Shown on screens 768px and below. Falls back to desktop image if not set."
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Background color",
          "default": "#fef9c3"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow label",
          "default": "⚡ Now in 10 minutes"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Groceries delivered in minutes"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "Fresh produce, dairy, snacks & more"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "Button URL"
        },
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Product / illustration image (right side)"
        },
        {
          "type": "image_picker",
          "id": "product_image_mobile",
          "label": "Product image — mobile version",
          "info": "Optional separate image for mobile screens"
        },
        {
          "type": "range",
          "id": "product_image_width",
          "label": "Product image width",
          "min": 100, "max": 400, "step": 10, "default": 220,
          "unit": "px"
        },
        {
          "type": "header",
          "content": "Eyebrow Text Style"
        },
        {
          "type": "range",
          "id": "eyebrow_size",
          "label": "Eyebrow font size",
          "min": 10, "max": 28, "step": 1, "default": 13,
          "unit": "px"
        },
        {
          "type": "color",
          "id": "eyebrow_color",
          "label": "Eyebrow text color",
          "default": "#555555"
        },
        {
          "type": "header",
          "content": "Heading Style"
        },
        {
          "type": "range",
          "id": "heading_size_override",
          "label": "Heading font size (0 = use section default)",
          "min": 0, "max": 72, "step": 2, "default": 0,
          "unit": "px",
          "info": "Set to 0 to use the section-level heading size above"
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Heading text color",
          "default": "#111111"
        },
        {
          "type": "select",
          "id": "heading_weight",
          "label": "Heading font weight",
          "options": [
            { "value": "400", "label": "Regular" },
            { "value": "500", "label": "Medium" },
            { "value": "600", "label": "Semi Bold" },
            { "value": "700", "label": "Bold" },
            { "value": "800", "label": "Extra Bold" }
          ],
          "default": "800"
        },
        {
          "type": "header",
          "content": "Subheading Style"
        },
        {
          "type": "range",
          "id": "subheading_size_override",
          "label": "Subheading font size (0 = use section default)",
          "min": 0, "max": 32, "step": 1, "default": 0,
          "unit": "px"
        },
        {
          "type": "color",
          "id": "subheading_color",
          "label": "Subheading text color",
          "default": "#555555"
        },
        {
          "type": "header",
          "content": "Button Style"
        },
        {
          "type": "color",
          "id": "cta_bg_color",
          "label": "Button background color",
          "default": "#111111"
        },
        {
          "type": "color",
          "id": "cta_text_color",
          "label": "Button text color",
          "default": "#ffffff"
        },
        {
          "type": "range",
          "id": "cta_font_size",
          "label": "Button font size",
          "min": 10, "max": 20, "step": 1, "default": 14,
          "unit": "px"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Banner",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "bg_color": "#fef9c3",
            "eyebrow": "⚡ Delivery in 10 minutes",
            "heading": "Groceries at your door, instantly",
            "subheading": "Fresh produce, dairy, snacks & essentials",
            "cta_label": "Shop Now"
          }
        },
        {
          "type": "slide",
          "settings": {
            "bg_color": "#dcfce7",
            "eyebrow": "🥦 Farm Fresh",
            "heading": "Fresh fruits & vegetables",
            "subheading": "Sourced daily from local farms",
            "cta_label": "Shop Produce"
          }
        },
        {
          "type": "slide",
          "settings": {
            "bg_color": "#fce7f3",
            "eyebrow": "🎉 Today's Deals",
            "heading": "Up to 40% off on daily essentials",
            "subheading": "Limited time offers every day",
            "cta_label": "See Deals"
          }
        }
      ]
    }
  ]
}
{% endschema %}