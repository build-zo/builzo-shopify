{% comment %}FILE: sections/bz-offers.liquid{% endcomment %}

<section class="bz-section bz-offers" data-section-id="{{ section.id }}">
  <div style="max-width: var(--bz-max-width, 1280px); margin: 0 auto;">
  <div class="bz-section-head" style="padding: 20px var(--bz-pad-h, 20px) 0;">
    <h2 class="bz-section-title">{{ section.settings.title | default: '🔥 Best Offers' }}</h2>
    {%- if section.settings.view_all_url != blank -%}
      <a href="{{ section.settings.view_all_url }}" class="bz-view-all">View all →</a>
    {%- endif -%}
  </div>

  <!-- Offer tabs -->
  {%- if section.settings.show_tabs -%}
    <div class="bz-offers__tabs" id="bzOfferTabs" style="padding-left: var(--bz-pad-h, 20px); padding-right: var(--bz-pad-h, 20px);">
      <button class="bz-offers__tab active" data-tab="all">All</button>
      {%- for block in section.blocks -%}
        {%- if block.type == 'tab' -%}
          <button class="bz-offers__tab" data-tab="{{ block.settings.id }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</button>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="bz-scroll-wrap" style="padding-left: var(--bz-pad-h, 20px); padding-right: var(--bz-pad-h, 20px);">
    <div class="bz-scroll-track bz-offers__track">
      {%- for block in section.blocks -%}
        {%- if block.type == 'offer_card' -%}
          <a
            href="{{ block.settings.url | default: '#' }}"
            class="bz-offers__card"
            style="background: {{ block.settings.bg_color | default: '#FFF3D6' }}; width: {{ section.settings.card_width | default: 220 }}px; height: {{ section.settings.card_height | default: 110 }}px;"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.image != blank -%}
              <picture>
                {%- if block.settings.image_mobile != blank -%}
                  <source media="(max-width:768px)" srcset="{{ block.settings.image_mobile | image_url: width: 400 }}" />
                {%- endif -%}
                <img src="{{ block.settings.image | image_url: width: 440 }}" alt="{{ block.settings.title | escape }}" width="{{ section.settings.card_width | default: 220 }}" height="{{ section.settings.card_height | default: 110 }}" loading="lazy" style="width:100%;height:100%;object-fit:cover;border-radius:inherit;" />
              </picture>
            {%- else -%}
              <div class="bz-offers__card-content">
                {%- if block.settings.badge != blank -%}
                  <span class="bz-offers__badge" style="background:{{ block.settings.badge_color | default: '#EF4444' }};color:#fff;">{{ block.settings.badge }}</span>
                {%- endif -%}
                <p class="bz-offers__card-label">{{ block.settings.label }}</p>
                <p class="bz-offers__card-title">{{ block.settings.title }}</p>
              </div>
            {%- endif -%}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  </div>
</section>

<style>
  .bz-offers__tabs {
    display: flex;
    gap: 8px;
    padding: 0 var(--bz-pad-h) 12px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .bz-offers__tabs::-webkit-scrollbar { display: none; }
  .bz-offers__tab {
    flex-shrink: 0;
    padding: 6px 16px;
    border-radius: 999px;
    border: 1.5px solid var(--bz-border);
    background: var(--bz-white);
    font-size: var(--bz-font-sm);
    font-weight: 600;
    color: var(--bz-gray);
    cursor: pointer;
    font-family: inherit;
    transition: all 0.15s;
  }
  .bz-offers__tab.active,
  .bz-offers__tab:hover {
    background: var(--bz-yellow);
    border-color: var(--bz-yellow);
    color: var(--bz-black);
  }
  .bz-offers__card {
    flex-shrink: 0;
    border-radius: var(--bz-radius-lg);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: transform 0.15s;
  }
  .bz-offers__card:hover { transform: translateY(-2px); }
  .bz-offers__card-content { padding: 14px; z-index: 1; }
  .bz-offers__badge {
    display: inline-block;
    font-size: var(--bz-font-xs);
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 5px;
    margin-bottom: 6px;
    letter-spacing: 0.03em;
  }
  .bz-offers__card-label { font-size: var(--bz-font-xs); font-weight: 600; color: var(--bz-gray-dark); margin: 0 0 3px; text-transform: uppercase; letter-spacing: 0.04em; }
  .bz-offers__card-title { font-size: var(--bz-font-md); font-weight: 700; color: var(--bz-black); margin: 0; line-height: 1.3; }
</style>

{% schema %}
{
  "name": "Offers Strip",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Section title", "default": "🔥 Best Offers" },
    { "type": "url", "id": "view_all_url", "label": "View all link" },
    { "type": "checkbox", "id": "show_tabs", "label": "Show offer tabs", "default": true },
    { "type": "header", "content": "Card Size" },
    { "type": "range", "id": "card_width", "label": "Card width", "min": 150, "max": 320, "step": 10, "default": 220, "unit": "px" },
    { "type": "range", "id": "card_height", "label": "Card height", "min": 80, "max": 200, "step": 10, "default": 110, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Offer Tab",
      "settings": [
        { "type": "text", "id": "id", "label": "Tab ID (unique)", "default": "tab1" },
        { "type": "text", "id": "label", "label": "Tab label", "default": "Current Offers" }
      ]
    },
    {
      "type": "offer_card",
      "name": "Offer Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Card image (desktop)", "info": "If set, overrides text content" },
        { "type": "image_picker", "id": "image_mobile", "label": "Card image (mobile)" },
        { "type": "color", "id": "bg_color", "label": "Background color", "default": "#FFF3D6" },
        { "type": "text", "id": "badge", "label": "Badge text", "default": "40% OFF" },
        { "type": "color", "id": "badge_color", "label": "Badge color", "default": "#EF4444" },
        { "type": "text", "id": "label", "label": "Label", "default": "Limited Time" },
        { "type": "text", "id": "title", "label": "Title", "default": "UltraTech Cement" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [{
    "name": "Offers Strip",
    "blocks": [
      { "type": "tab", "settings": { "id": "current", "label": "Current Offers" } },
      { "type": "tab", "settings": { "id": "bulk", "label": "Bulk Offers" } },
      { "type": "offer_card", "settings": { "bg_color": "#FFF3D6", "badge": "FLAT 4% OFF", "badge_color": "#F5A623", "label": "On Cement", "title": "UltraTech Cement" } },
      { "type": "offer_card", "settings": { "bg_color": "#FEE2E2", "badge": "SAVE ₹500", "badge_color": "#EF4444", "label": "Bulk Order", "title": "TMT Bars 12mm" } },
      { "type": "offer_card", "settings": { "bg_color": "#DCFCE7", "badge": "FREE DELIVERY", "badge_color": "#16A34A", "label": "Above ₹5000", "title": "All Products" } }
    ]
  }]
}
{% endschema %}