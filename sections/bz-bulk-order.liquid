{% comment %}
  FILE: sections/bz-bulk-order.liquid
  Full contractor/builder landing page with:
  - Hero with headline and WhatsApp CTA
  - Benefits grid
  - Pricing tiers
  - Quote request form
  - How it works steps
{% endcomment %}

{%- assign wa_number = section.settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' | strip -%}

<div class="bz-bulk" data-section-id="{{ section.id }}">

  <!-- ── HERO ──────────────────────────────────────────────── -->
  <div class="bz-bulk__hero" style="background: {{ section.settings.hero_bg | default: '#1A1A1A' }};">
    <div class="bz-inner bz-bulk__hero-inner">
      <div class="bz-bulk__hero-text">
        <span class="bz-bulk__hero-eyebrow">{{ section.settings.eyebrow | default: 'FOR CONTRACTORS & BUILDERS' }}</span>
        <h1 class="bz-bulk__hero-title">{{ section.settings.hero_title | default: 'Better Prices for Big Builders' }}</h1>
        <p class="bz-bulk__hero-desc">{{ section.settings.hero_desc | default: 'Special pricing on bulk orders. Dedicated relationship manager. GST invoice guaranteed.' }}</p>

        <div class="bz-bulk__hero-actions">
          <a
            href="https://wa.me/{{ wa_number }}?text={{ section.settings.whatsapp_message | default: 'Hi! I want to place a bulk order. Please share details.' | url_encode }}"
            target="_blank"
            rel="noopener"
            class="bz-btn bz-btn--whatsapp bz-btn--lg"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            {{ section.settings.wa_btn_label | default: 'Chat on WhatsApp' }}
          </a>
          <a href="#bz-bulk-form" class="bz-btn bz-btn--outline" style="color:#fff;border-color:rgba(255,255,255,0.4);">
            {{ section.settings.form_btn_label | default: 'Request a Quote' }}
          </a>
        </div>
      </div>

      {%- if section.settings.hero_image != blank -%}
        <div class="bz-bulk__hero-img">
          <img
            src="{{ section.settings.hero_image | image_url: width: 500 }}"
            alt="{{ section.settings.hero_title | escape }}"
            width="500"
            height="400"
            loading="eager"
            style="width:100%;height:auto;object-fit:contain;"
          />
        </div>
      {%- endif -%}
    </div>
  </div>

  <!-- ── BENEFITS ───────────────────────────────────────────── -->
  {%- assign benefit_blocks = section.blocks | where: 'type', 'benefit' -%}
  {%- if benefit_blocks.size > 0 -%}
    <div class="bz-bulk__benefits bz-section">
      <div class="bz-inner" style="padding: 32px var(--bz-pad-h);">
        {%- if section.settings.benefits_title != blank -%}
          <h2 class="bz-section-title" style="margin-bottom:20px;text-align:center;">{{ section.settings.benefits_title }}</h2>
        {%- endif -%}
        <div class="bz-bulk__benefits-grid">
          {%- for block in section.blocks -%}
            {%- if block.type == 'benefit' -%}
              <div class="bz-bulk__benefit-card" {{ block.shopify_attributes }}>
                <span class="bz-bulk__benefit-icon">{{ block.settings.icon }}</span>
                <h3 class="bz-bulk__benefit-title">{{ block.settings.title }}</h3>
                <p class="bz-bulk__benefit-desc">{{ block.settings.desc }}</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  <!-- ── HOW IT WORKS ───────────────────────────────────────── -->
  {%- assign step_blocks = section.blocks | where: 'type', 'step' -%}
  {%- if step_blocks.size > 0 -%}
    <div class="bz-bulk__steps bz-section">
      <div class="bz-inner" style="padding: 32px var(--bz-pad-h);">
        {%- if section.settings.steps_title != blank -%}
          <h2 class="bz-section-title" style="margin-bottom:24px;text-align:center;">{{ section.settings.steps_title }}</h2>
        {%- endif -%}
        <div class="bz-bulk__steps-track">
          {%- assign step_num = 1 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'step' -%}
              <div class="bz-bulk__step" {{ block.shopify_attributes }}>
                <div class="bz-bulk__step-num">{{ step_num }}</div>
                <h3 class="bz-bulk__step-title">{{ block.settings.title }}</h3>
                <p class="bz-bulk__step-desc">{{ block.settings.desc }}</p>
              </div>
              {%- assign step_num = step_num | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  <!-- ── QUOTE FORM ─────────────────────────────────────────── -->
  {%- if section.settings.show_form -%}
    <div class="bz-bulk__form-section bz-section" id="bz-bulk-form">
      <div class="bz-inner" style="padding: 40px var(--bz-pad-h);">
        <div class="bz-bulk__form-card">
          <h2 class="bz-bulk__form-title">{{ section.settings.form_title | default: 'Get a Custom Quote' }}</h2>
          <p class="bz-bulk__form-desc">{{ section.settings.form_desc | default: 'Fill in the details below and our team will contact you within 30 minutes.' }}</p>

          <form class="bz-bulk__form" id="bzBulkForm" novalidate>
            <div class="bz-bulk__form-row">
              <div class="bz-bulk__form-field">
                <label class="bz-bulk__form-label">{{ section.settings.label_name | default: 'Your Name' }} *</label>
                <input type="text" name="name" class="bz-input" placeholder="{{ section.settings.ph_name | default: 'e.g. Sandeep Singh' }}" required />
              </div>
              <div class="bz-bulk__form-field">
                <label class="bz-bulk__form-label">{{ section.settings.label_phone | default: 'Phone Number' }} *</label>
                <input type="tel" name="phone" class="bz-input" placeholder="{{ section.settings.ph_phone | default: 'e.g. 98765 43210' }}" required />
              </div>
            </div>

            <div class="bz-bulk__form-row">
              <div class="bz-bulk__form-field">
                <label class="bz-bulk__form-label">{{ section.settings.label_city | default: 'City / Area' }}</label>
                <input type="text" name="city" class="bz-input" placeholder="{{ section.settings.ph_city | default: 'e.g. Bathinda' }}" />
              </div>
              <div class="bz-bulk__form-field">
                <label class="bz-bulk__form-label">{{ section.settings.label_gst | default: 'GST Number' }} (optional)</label>
                <input type="text" name="gst" class="bz-input" placeholder="e.g. 03ABCDE1234F1Z5" maxlength="15" autocapitalize="characters" />
              </div>
            </div>

            <div class="bz-bulk__form-field">
              <label class="bz-bulk__form-label">{{ section.settings.label_products | default: 'Products Required' }} *</label>
              <textarea name="products" class="bz-input bz-bulk__form-textarea" placeholder="{{ section.settings.ph_products | default: 'e.g. UltraTech Cement 50kg × 200 bags, TMT Bar 12mm × 50 pieces...' }}" rows="4" required></textarea>
            </div>

            <button type="submit" class="bz-btn bz-btn--primary bz-btn--full bz-btn--lg" id="bzBulkSubmit">
              {{ section.settings.submit_label | default: 'Send Quote Request via WhatsApp' }}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            </button>

            <p class="bz-bulk__form-note">{{ section.settings.form_note | default: '✅ Our team will confirm your order and share pricing within 30 minutes.' }}</p>
          </form>
        </div>
      </div>
    </div>
  {%- endif -%}

</div>

<style>
/* ── Hero ──────────────────────────────────────────────── */
.bz-bulk__hero { color: #fff; }
.bz-bulk__hero-inner {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  gap: 32px;
  padding: 48px var(--bz-pad-h);
}
.bz-bulk__hero-eyebrow {
  display: inline-block;
  font-size: var(--bz-font-xs);
  font-weight: 700;
  letter-spacing: 0.1em;
  color: var(--bz-yellow);
  background: rgba(245,166,35,0.15);
  border: 1px solid rgba(245,166,35,0.3);
  border-radius: 999px;
  padding: 4px 12px;
  margin-bottom: 14px;
}
.bz-bulk__hero-title {
  font-size: clamp(24px, 4vw, 42px);
  font-weight: 800;
  color: #fff;
  line-height: 1.15;
  letter-spacing: -0.02em;
  margin: 0 0 14px;
  max-width: 520px;
}
.bz-bulk__hero-desc {
  font-size: var(--bz-font-md);
  color: rgba(255,255,255,0.75);
  margin: 0 0 28px;
  line-height: 1.6;
  max-width: 480px;
}
.bz-bulk__hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }
.bz-bulk__hero-img { width: 300px; flex-shrink: 0; }

/* ── Benefits ──────────────────────────────────────────── */
.bz-bulk__benefits-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 16px;
}
.bz-bulk__benefit-card {
  background: var(--bz-gray-light);
  border-radius: var(--bz-radius-lg);
  padding: 20px;
  text-align: center;
  border: 1px solid var(--bz-border);
  transition: box-shadow 0.15s;
}
.bz-bulk__benefit-card:hover { box-shadow: var(--bz-shadow-md); }
.bz-bulk__benefit-icon { font-size: 32px; display: block; margin-bottom: 10px; }
.bz-bulk__benefit-title { font-size: var(--bz-font-base); font-weight: 700; color: var(--bz-black); margin: 0 0 6px; }
.bz-bulk__benefit-desc { font-size: var(--bz-font-sm); color: var(--bz-gray); margin: 0; line-height: 1.5; }

/* ── How it works ──────────────────────────────────────── */
.bz-bulk__steps-track {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 0;
  position: relative;
}
.bz-bulk__steps-track::before {
  content: '';
  position: absolute;
  top: 24px;
  left: 10%;
  right: 10%;
  height: 2px;
  background: var(--bz-yellow-light);
  z-index: 0;
}
.bz-bulk__step {
  text-align: center;
  padding: 0 16px;
  position: relative;
  z-index: 1;
}
.bz-bulk__step-num {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: var(--bz-yellow);
  color: var(--bz-black);
  font-size: var(--bz-font-lg);
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 14px;
  box-shadow: 0 0 0 4px var(--bz-yellow-light);
}
.bz-bulk__step-title { font-size: var(--bz-font-base); font-weight: 700; color: var(--bz-black); margin: 0 0 6px; }
.bz-bulk__step-desc { font-size: var(--bz-font-sm); color: var(--bz-gray); margin: 0; line-height: 1.5; }

/* ── Quote Form ────────────────────────────────────────── */
.bz-bulk__form-card {
  max-width: 680px;
  margin: 0 auto;
  background: var(--bz-white);
  border-radius: var(--bz-radius-xl);
  padding: 36px 32px;
  box-shadow: var(--bz-shadow-lg);
}
.bz-bulk__form-title { font-size: var(--bz-font-2xl); font-weight: 800; color: var(--bz-black); margin: 0 0 8px; }
.bz-bulk__form-desc { font-size: var(--bz-font-base); color: var(--bz-gray); margin: 0 0 24px; }
.bz-bulk__form { display: flex; flex-direction: column; gap: 16px; }
.bz-bulk__form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.bz-bulk__form-field { display: flex; flex-direction: column; gap: 6px; }
.bz-bulk__form-label { font-size: var(--bz-font-sm); font-weight: 600; color: var(--bz-black); }
.bz-bulk__form-textarea { height: auto; padding: 12px 14px; resize: vertical; }
.bz-bulk__form-note { font-size: var(--bz-font-sm); color: var(--bz-gray); margin: 4px 0 0; text-align: center; }

/* ── Responsive ────────────────────────────────────────── */
@media (max-width: 768px) {
  .bz-bulk__hero-inner { grid-template-columns: 1fr; }
  .bz-bulk__hero-img { display: none; }
  .bz-bulk__form-row { grid-template-columns: 1fr; }
  .bz-bulk__form-card { padding: 24px 20px; }
  .bz-bulk__steps-track::before { display: none; }
}
</style>

<script>
(function () {
  var form   = document.getElementById('bzBulkForm');
  var waNum  = '{{ wa_number }}';

  if (!form) return;

  form.addEventListener('submit', function (e) {
    e.preventDefault();

    var name     = (form.querySelector('[name="name"]') || {}).value || '';
    var phone    = (form.querySelector('[name="phone"]') || {}).value || '';
    var city     = (form.querySelector('[name="city"]') || {}).value || '';
    var gst      = (form.querySelector('[name="gst"]') || {}).value || '';
    var products = (form.querySelector('[name="products"]') || {}).value || '';

    if (!name.trim() || !phone.trim() || !products.trim()) {
      alert('Please fill in Name, Phone and Products Required.');
      return;
    }

    /* Build WhatsApp message from form data */
    var msg = '🏗️ *Bulk Order Request*\n\n'
      + '*Name:* ' + name + '\n'
      + '*Phone:* ' + phone + '\n'
      + (city ? '*City:* ' + city + '\n' : '')
      + (gst  ? '*GST:* '  + gst  + '\n' : '')
      + '\n*Products Required:*\n' + products;

    var url = 'https://wa.me/' + waNum + '?text=' + encodeURIComponent(msg);
    window.open(url, '_blank');
  });
})();
</script>

{% schema %}
{
  "name": "Bulk Order Page",
  "tag": "div",
  "settings": [
    {
      "type": "header",
      "content": "Hero Section"
    },
    { "type": "text",     "id": "eyebrow",      "label": "Eyebrow label",    "default": "FOR CONTRACTORS & BUILDERS" },
    { "type": "textarea", "id": "hero_title",   "label": "Headline",          "default": "Better Prices for Big Builders" },
    { "type": "textarea", "id": "hero_desc",    "label": "Description",       "default": "Special pricing on bulk orders. Dedicated relationship manager. GST invoice guaranteed." },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image (right side)" },
    { "type": "color",    "id": "hero_bg",      "label": "Hero background",   "default": "#1A1A1A" },
    {
      "type": "header",
      "content": "WhatsApp"
    },
    { "type": "text",     "id": "whatsapp_number",  "label": "WhatsApp number (with country code)", "info": "Example: 919876543210 for +91 98765 43210" },
    { "type": "textarea", "id": "whatsapp_message", "label": "Pre-filled WhatsApp message",          "default": "Hi! I want to place a bulk order. Please share details." },
    { "type": "text",     "id": "wa_btn_label",     "label": "WhatsApp button text",                 "default": "Chat on WhatsApp" },
    { "type": "text",     "id": "form_btn_label",   "label": "Form button text",                     "default": "Request a Quote" },
    {
      "type": "header",
      "content": "Benefits Section"
    },
    { "type": "text", "id": "benefits_title", "label": "Benefits section title", "default": "Bulk Order Benefits" },
    {
      "type": "header",
      "content": "How It Works"
    },
    { "type": "text", "id": "steps_title", "label": "Steps section title", "default": "How It Works" },
    {
      "type": "header",
      "content": "Quote Form"
    },
    { "type": "checkbox",  "id": "show_form",       "label": "Show quote form",        "default": true },
    { "type": "text",      "id": "form_title",       "label": "Form title",             "default": "Get a Custom Quote" },
    { "type": "textarea",  "id": "form_desc",        "label": "Form description",       "default": "Fill in the details below and our team will contact you within 30 minutes." },
    { "type": "text",      "id": "submit_label",     "label": "Submit button text",     "default": "Send Quote Request via WhatsApp" },
    { "type": "textarea",  "id": "form_note",        "label": "Note below form",        "default": "✅ Our team will confirm your order and share pricing within 30 minutes." },
    { "type": "header",    "content": "Form Field Labels" },
    { "type": "text", "id": "label_name",     "label": "Name label",          "default": "Your Name" },
    { "type": "text", "id": "label_phone",    "label": "Phone label",         "default": "Phone Number" },
    { "type": "text", "id": "label_city",     "label": "City label",          "default": "City / Area" },
    { "type": "text", "id": "label_gst",      "label": "GST label",           "default": "GST Number" },
    { "type": "text", "id": "label_products", "label": "Products label",      "default": "Products Required" },
    { "type": "header",    "content": "Form Placeholders" },
    { "type": "text", "id": "ph_name",     "label": "Name placeholder",     "default": "e.g. Sandeep Singh" },
    { "type": "text", "id": "ph_phone",    "label": "Phone placeholder",    "default": "e.g. 98765 43210" },
    { "type": "text", "id": "ph_city",     "label": "City placeholder",     "default": "e.g. Bathinda" },
    { "type": "text", "id": "ph_products", "label": "Products placeholder", "default": "e.g. UltraTech Cement 50kg × 200 bags..." }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Card",
      "settings": [
        { "type": "text", "id": "icon",  "label": "Emoji icon", "default": "💰" },
        { "type": "text", "id": "title", "label": "Title",      "default": "Special Pricing" },
        { "type": "text", "id": "desc",  "label": "Description","default": "Exclusive rates on bulk quantities for contractors." }
      ]
    },
    {
      "type": "step",
      "name": "How It Works Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Step title", "default": "Submit Request" },
        { "type": "text", "id": "desc",  "label": "Description", "default": "Fill the form or WhatsApp us with your requirements." }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "Bulk Order Page",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "💰", "title": "Special Pricing",          "desc": "Exclusive rates on bulk quantities for contractors and builders." } },
        { "type": "benefit", "settings": { "icon": "👤", "title": "Dedicated Manager",        "desc": "A dedicated relationship manager for all your orders." } },
        { "type": "benefit", "settings": { "icon": "🧾", "title": "GST Invoice",              "desc": "Proper GST invoices for all bulk purchases." } },
        { "type": "benefit", "settings": { "icon": "🚚", "title": "Priority Delivery",        "desc": "Your bulk orders are dispatched on priority." } },
        { "type": "step",    "settings": { "title": "Submit Your Requirement", "desc": "Fill the form or WhatsApp us with product names and quantities." } },
        { "type": "step",    "settings": { "title": "Get Best Quote",           "desc": "Our team will share the best price within 30 minutes." } },
        { "type": "step",    "settings": { "title": "Confirm & Pay",            "desc": "Confirm the order and pay via UPI or COD." } },
        { "type": "step",    "settings": { "title": "Fast Delivery",            "desc": "Materials delivered to your site on time." } }
      ]
    }
  ]
}
{% endschema %}