{% doc %}
  @prompt
    Cards showing categories of different types of products we offer
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-category-cards-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-category-cards-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: {{ block.settings.card_spacing }}px;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-category-card-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    flex-direction: column;
    background-color: {{ block.settings.card_background_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-category-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }

  .ai-category-card-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    overflow: hidden;
  }

  .ai-category-card-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-category-card-{{ ai_gen_id }}:hover .ai-category-card-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-category-card-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-category-card-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-category-card-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex-grow: 1;
  }

  .ai-category-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: 600;
    color: {{ block.settings.title_color }};
    margin: 0;
    line-height: 1.3;
  }

  .ai-category-card-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_font_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-category-card-cta-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: {{ block.settings.cta_font_size }}px;
    color: {{ block.settings.cta_color }};
    font-weight: 500;
    margin-top: auto;
  }

  .ai-category-card-cta-arrow-{{ ai_gen_id }} {
    transition: transform 0.3s ease;
  }

  .ai-category-card-{{ ai_gen_id }}:hover .ai-category-card-cta-arrow-{{ ai_gen_id }} {
    transform: translateX(4px);
  }

  .ai-category-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    color: #666;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-category-cards-container-{{ ai_gen_id }} {
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: {{ block.settings.card_spacing | times: 0.75 }}px;
    }

    .ai-category-card-content-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.75 }}px;
    }
  }
{% endstyle %}

<category-cards-{{ ai_gen_id }} class="ai-category-cards-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% liquid
    assign has_any_category = false
    for i in (1..6)
      assign category_enabled_key = 'category_' | append: i | append: '_enabled'
      if block.settings[category_enabled_key]
        assign has_any_category = true
        break
      endif
    endfor
  %}

  {% if has_any_category %}
    <div class="ai-category-cards-container-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign category_enabled_key = 'category_' | append: i | append: '_enabled'
          assign category_title_key = 'category_' | append: i | append: '_title'
          assign category_description_key = 'category_' | append: i | append: '_description'
          assign category_image_key = 'category_' | append: i | append: '_image'
          assign category_link_key = 'category_' | append: i | append: '_link'

          assign category_enabled = block.settings[category_enabled_key]
          assign category_title = block.settings[category_title_key]
          assign category_description = block.settings[category_description_key]
          assign category_image = block.settings[category_image_key]
          assign category_link = block.settings[category_link_key]
        %}

        {% if category_enabled %}
          <a
            href="{{ category_link | default: '#' }}"
            class="ai-category-card-{{ ai_gen_id }}"
          >
            <div class="ai-category-card-image-wrapper-{{ ai_gen_id }}">
              {% if category_image %}
                <img
                  src="{{ category_image | image_url: width: 600 }}"
                  alt="{{ category_image.alt | escape }}"
                  loading="lazy"
                  width="600"
                  height="{{ 600 | divided_by: block.settings.image_aspect_ratio | round }}"
                  class="ai-category-card-image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-category-card-image-placeholder-{{ ai_gen_id }}">
                  {{ 'collection-apparel-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <div class="ai-category-card-content-{{ ai_gen_id }}">
              {% if category_title != blank %}
                <h3 class="ai-category-card-title-{{ ai_gen_id }}">{{ category_title }}</h3>
              {% endif %}

              {% if category_description != blank %}
                <p class="ai-category-card-description-{{ ai_gen_id }}">{{ category_description }}</p>
              {% endif %}

              <span class="ai-category-card-cta-{{ ai_gen_id }}">
                {{ block.settings.cta_text }}
                <span class="ai-category-card-cta-arrow-{{ ai_gen_id }}">→</span>
              </span>
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  {% else %}
    <div class="ai-category-empty-state-{{ ai_gen_id }}">
      Enable at least one category to display cards
    </div>
  {% endif %}
</category-cards-{{ ai_gen_id }}>

<script>
  (function() {
    class CategoryCards{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.cards = this.querySelectorAll('.ai-category-card-{{ ai_gen_id }}');
        this.setupAccessibility();
      }

      setupAccessibility() {
        this.cards.forEach((card) => {
          card.setAttribute('role', 'link');
        });
      }
    }

    customElements.define('category-cards-{{ ai_gen_id }}', CategoryCards{{ ai_gen_id }});
  })();
</script>

