{% doc %}
  @prompt
    I need a branding carousel here where we can display content but the content shall be different for both web and mobile view
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-branding-carousel-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    position: relative;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-branding-carousel-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.item_gap }}px;
    animation: ai-branding-carousel-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
  }

  .ai-branding-carousel-{{ ai_gen_id }}:hover .ai-branding-carousel-track-{{ ai_gen_id }} {
    animation-play-state: paused;
  }

  .ai-branding-carousel-item-{{ ai_gen_id }} {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: {{ block.settings.item_width }}px;
    height: {{ block.settings.item_height }}px;
  }

  .ai-branding-carousel-item-{{ ai_gen_id }} img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    opacity: {{ block.settings.image_opacity }};
    filter: grayscale({{ block.settings.grayscale_percent }}%);
    transition: all 0.3s ease;
  }

  .ai-branding-carousel-item-{{ ai_gen_id }}:hover img {
    opacity: 1;
    filter: grayscale(0%);
  }

  .ai-branding-carousel-desktop-{{ ai_gen_id }} {
    display: block;
  }

  .ai-branding-carousel-mobile-{{ ai_gen_id }} {
    display: none;
  }

  @keyframes ai-branding-carousel-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-branding-carousel-desktop-{{ ai_gen_id }} {
      display: none;
    }

    .ai-branding-carousel-mobile-{{ ai_gen_id }} {
      display: block;
    }

    .ai-branding-carousel-item-{{ ai_gen_id }} {
      min-width: {{ block.settings.mobile_item_width }}px;
      height: {{ block.settings.mobile_item_height }}px;
    }
  }
{% endstyle %}

<branding-carousel-{{ ai_gen_id }} class="ai-branding-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-branding-carousel-desktop-{{ ai_gen_id }}">
    <div class="ai-branding-carousel-track-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign image_key = 'desktop_image_' | append: i
          assign image = block.settings[image_key]
        %}
        {% if image %}
          <div class="ai-branding-carousel-item-{{ ai_gen_id }}">
            <img
              src="{{ image | image_url: width: 400 }}"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              width="{{ image.width }}"
              height="{{ image.height }}"
            >
          </div>
        {% endif %}
      {% endfor %}
      {% for i in (1..6) %}
        {% liquid
          assign image_key = 'desktop_image_' | append: i
          assign image = block.settings[image_key]
        %}
        {% if image %}
          <div class="ai-branding-carousel-item-{{ ai_gen_id }}">
            <img
              src="{{ image | image_url: width: 400 }}"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              width="{{ image.width }}"
              height="{{ image.height }}"
            >
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <div class="ai-branding-carousel-mobile-{{ ai_gen_id }}">
    <div class="ai-branding-carousel-track-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign image_key = 'mobile_image_' | append: i
          assign image = block.settings[image_key]
        %}
        {% if image %}
          <div class="ai-branding-carousel-item-{{ ai_gen_id }}">
            <img
              src="{{ image | image_url: width: 300 }}"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              width="{{ image.width }}"
              height="{{ image.height }}"
            >
          </div>
        {% endif %}
      {% endfor %}
      {% for i in (1..6) %}
        {% liquid
          assign image_key = 'mobile_image_' | append: i
          assign image = block.settings[image_key]
        %}
        {% if image %}
          <div class="ai-branding-carousel-item-{{ ai_gen_id }}">
            <img
              src="{{ image | image_url: width: 300 }}"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              width="{{ image.width }}"
              height="{{ image.height }}"
            >
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</branding-carousel-{{ ai_gen_id }}>

